GOOGLE_MAPS_SERVER_KEY=
NVIDIA_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LangSmith tracing is off until both of these are set. LangChain reads them
# from the process environment; bootstrap copies the Settings values there.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=google-maps-chatbot